# Copy to controller/.env (gitignored) and fill in. Never commit the real file.
#   cp controller/.env.example controller/.env

# Google Gemini key (https://aistudio.google.com/app/apikey). Used by:
#   - the dashboard Copilot chat + AI briefs (make dashboard, :8050)  -> picked up immediately, no restart
#   - the M5 analyzer (make report --llm)                             -> after restarting the controller
GEMINI_API_KEY=

# Optional: pin a model for the Copilot. Default gemini-flash-latest (always the current Flash model);
# if a model is retired the newest available gemini-<version>-flash is picked automatically.
# CHAT_MODEL=gemini-3.8-flash

# Optional, NOT needed for the dashboard: true also makes the M2 planner (/api/v1/plan) re-rank fault
# candidates with Gemini. The heuristic planner is the primary path, so leave this off unless you want that.
# USE_LLM=true
